# Copie para .env e ajuste:   cp .env.example .env
# (o .env tem de ficar no mesmo diretório do docker-compose.yml; não o envie ao Git)

# ---------------------------------------------------------------- senhas --
# Aplicadas só quando os bancos são criados pela primeira vez.
# Para mudar depois: docker-compose down -v && docker-compose up --build -d
MYSQL_ROOT_PASSWORD=change-me-db
KEYROCK_ADMIN_EMAIL=admin@example.com
KEYROCK_ADMIN_PASSWORD=change-me-admin

# ----------------------------------------------------------------- FIWARE --
# Endereço da máquina onde o FIWARE roda (Orion 1026, IoT Agent 4041, STH-Comet 8666, Mosquitto 1883).
FIWARE_HOST=18.212.244.165

# Como o servidor do FIWARE alcança ESTA API (é por aqui que cada leitura volta a você).
# TEM de ser alcançável A PARTIR DO SERVIDOR DO FIWARE. Um notebook atrás de NAT não é: veja DEPLOY-AWS.md.
#   back-end em outro servidor : http://<IP desse servidor>:8000/internal/orion/notify
#   notebook + Tailscale       : http://<IP Tailscale do notebook, 100.x.y.z>:8000/internal/orion/notify
#   notebook + ngrok           : https://<algo>.ngrok-free.app/internal/orion/notify
NOTIFY_URL=http://localhost:8000/internal/orion/notify

# Endereço que o DISPOSITIVO (ESP32) usa para falar com o Mosquitto. Por padrão é o FIWARE_HOST.
# Defina se for diferente (ex.: FIWARE_HOST é um IP Tailscale, mas o ESP32 precisa do endereço público).
# MQTT_HOST=ec2-00-000-000-00.compute-1.amazonaws.com
# MQTT_PORT=1883

# --------------------------------------------------- preset: tudo neste computador --
# (Docker Desktop no Windows/Mac. No Linux, troque host.docker.internal pelo IP do docker0, ex. 172.17.0.1)
# FIWARE_HOST=host.docker.internal
# NOTIFY_URL=http://host.docker.internal:8000/internal/orion/notify
# MQTT_HOST=192.168.0.10        # o IP deste computador na rede, para o ESP32 (nunca host.docker.internal)

# ------------------------------------------------------------------- API --
# Segredo que o Orion envia nas notificações. Vazio = um aleatório a cada inicialização
# (a assinatura no Orion é atualizada sozinha).
# NOTIFY_TOKEN=

# Endereço público desta API (usado no cadastro do aplicativo OAuth no Keyrock).
# APP_URL=http://localhost:8000
# Origens do front-end autorizadas a chamar a API com cookie (separe por vírgula).
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# true quando a API é servida por HTTPS (ex.: atrás do ngrok ou de um proxy).
# COOKIE_SECURE=false

# Automação (liga/desliga pela API) e histórico.
# AUTOMATION_ENABLED=true
# AUTOMATION_RETRY_SECONDS=30
# STH_SERVICE=
# KEYROCK_IMAGE=quay.io/fiware/idm
