# Copy to .env and change the passwords:   cp .env.example .env
#
# NOTE: the Keyrock admin account and the MySQL password are applied only when
# the databases are first created. If you change them later, reset the stack:
#   docker compose down -v && docker compose up -d --build

MYSQL_ROOT_PASSWORD=change-me-db

# Use a normal-looking domain: the API validates e-mails and rejects
# reserved ones such as *.test or *.local.
KEYROCK_ADMIN_EMAIL=admin@example.com
KEYROCK_ADMIN_PASSWORD=change-me-admin

# Pin a specific Keyrock tag once you have a working one, e.g. quay.io/fiware/idm:<tag>
# KEYROCK_IMAGE=quay.io/fiware/idm

# Browser origins allowed to call the API with cookies (your React dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# true when the API is served over HTTPS
COOKIE_SECURE=false

# Optional: skip the automatic OAuth-app registration by providing credentials
# of an application you created yourself in the Keyrock GUI
# (grant types: Resource Owner Password Credentials + Refresh Token).
# KEYROCK_CLIENT_ID=
# KEYROCK_CLIENT_SECRET=

# ---------------------------------------------------------------- FIWARE --
# The course stack runs in its own compose project on this same computer.
# Start it first (docker-compose up -d in its folder), then find the network name:
#   docker network ls        -> usually "fiware_default"
FIWARE_NETWORK=fiware_default

# Only change these if your FIWARE compose uses other service names or an api key
# other than TEF (topics are /<apikey>/<deviceId>/attrs).
# ORION_URL=http://orion:1026
# IOTA_URL=http://iot-agent:4041
# IOTA_API_KEY=TEF

# History comes from STH-Comet, which is part of the same FIWARE stack (service name from
# the course compose; check with `docker ps`). The API makes Orion notify it automatically.
# STH_URL=http://fiware-sth-comet:8666
# STH_NOTIFY_URL=http://fiware-sth-comet:8666/notify
# STH files its data per service. The Orion subscription forces FIWARE_SERVICE (default
# "smartlamp"). Only if Orion refuses that (see README, "History is empty") set STH_SERVICE
# to the service STH-Comet really uses.
# STH_SERVICE=

# Automation: send on/off when a reading leaves the lamp's limits.
# AUTOMATION_ENABLED=true
# The same command is not repeated for this many seconds (the device needs time to answer);
# after that it is sent again, which also recovers a device that was offline.
# AUTOMATION_RETRY_SECONDS=30

# Host/port shown to the user for the lamp to connect to (the Mosquitto broker)
MQTT_HOST=localhost
MQTT_PORT=1883

# Optional fixed secret for Orion -> API notifications (random on each start if empty)
# NOTIFY_TOKEN=
